# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# --- Turso (libSQL) database ---------------------------------------------
# https://docs.turso.tech/sdk/ts/reference
TURSO_DATABASE_URL="libsql://<database-name>-<org>.turso.io"
TURSO_AUTH_TOKEN="<turso-auth-token>"

# --- Gemini API (@google/genai) -------------------------------------------
# https://github.com/googleapis/js-genai
# NOTE: env var name follows the SDK's documented default (GEMINI_API_KEY).
# Verify against the installed @google/genai version's docs at implementation
# time (M3) if the SDK's default lookup key has changed.
GEMINI_API_KEY="<gemini-api-key>"

# --- Better Auth (invite-only allowlist auth) ------------------------------
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="<random-32-byte-secret>"
BETTER_AUTH_URL="http://localhost:3000"
