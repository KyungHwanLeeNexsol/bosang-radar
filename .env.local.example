# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
#
# Scope matrix (SSOT: .moai/specs/SPEC-RUNTIME-001/design.md §3.1) — each
# variable's [scope: ...] tag below lists which execution purposes actually
# require it. See .moai/docs/runtime-runbook.md for the full walkthrough.
# migrate/seed/provision (via scripts/cli-bootstrap.ts) load THIS FILE
# directly — no shell `export` is needed for those three purposes.

# --- Turso (libSQL) database ---------------------------------------------
# https://docs.turso.tech/sdk/ts/reference
# [scope: db, provision, app, e2e] — required in all four.
# Local-mode example (no remote Turso instance, no auth token needed):
#   TURSO_DATABASE_URL="file:./.tmp/local-dev.db"
TURSO_DATABASE_URL="libsql://<database-name>-<org>.turso.io"
# [scope: db, provision, app, e2e] — conditionally required, only when
# TURSO_DATABASE_URL points at a remote instance (libsql:// or https://).
# Not needed with a file: URL above.
TURSO_AUTH_TOKEN="<turso-auth-token>"

# --- Gemini API (@google/genai) -------------------------------------------
# https://github.com/googleapis/js-genai
# Verified at M1 against the installed @google/genai@2.18.0 README Quickstart:
# `const GEMINI_API_KEY = process.env.GEMINI_API_KEY;` is the exact documented
# pattern. (The SDK's separate "NodeJS-only env var" convenience path reads
# GOOGLE_API_KEY instead, but lib/ai/providers/gemini.ts passes apiKey
# explicitly, so only GEMINI_API_KEY is consumed here.)
# [scope: NOT required for SPEC-RUNTIME-001 app boot] — the AI pipeline stays
# a mock implementation for this SPEC, so no execution path consumes this
# value yet. A later SPEC that enables real Gemini calls must promote this to
# an `app`-scope-required variable. Get a key at https://aistudio.google.com
# only if/when you need it for other work.
GEMINI_API_KEY="<gemini-api-key>"

# --- Better Auth (invite-only allowlist auth) ------------------------------
# https://www.better-auth.com/docs/installation
# [scope: provision, app, e2e (e2e generates its own — see below)]
BETTER_AUTH_SECRET="<random-32-byte-secret>"
# [scope: app, e2e (e2e assembles its own from a free local port)]
BETTER_AUTH_URL="http://localhost:3000"

# --- Non-interactive tester provisioning (optional) ------------------------
# [scope: provision] — only required when running `pnpm tester:add` WITHOUT
# the interactive email/password prompt (i.e. non-interactive/CI use). Not
# required for `pnpm test:e2e` — run-e2e.ts generates its own ephemeral
# tester password internally and does not read this variable.
TESTER_PASSWORD="<tester-password>"
