            {
              "type": "text",
              "id": "p7C0Cb",
              "name": "Desc",
              "fill": "$ink-2",
              "textGrowth": "fixed-width",
              "width": 760,
              "content": "데스크톱 1440px 기준. Pretendard 단일 서체. 사용자는 보험 청구자 본인이므로 전문용어를 쓰지 않고, 담보 카드의 3톤(청구 가능 · 조건부 · 해당 없음)으로 가능성을 전달합니다. v1의 손해사정사 워크스페이스 컴포넌트(사이드바 · 내비 · 근거 카드 등)는 제품 방향 변경으로 폐기했습니다.",
              "lineHeight": 1.7,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
